  "narrative": {
    "northStar": "The Compact Finance Console",
    "overview": "The incumbent application is an operational finance workspace: a dark slate shell, gently separated navy surfaces, small dense utility text, and conspicuous numeric summaries. Its single mint accent links primary actions, active navigation, positive amounts, and progress. The light theme preserves the same hierarchy while switching the surfaces and foreground palette. No redesign or reinterpretation is authorized by this document.\n\nThe UI expresses information primarily through typography, rectangular data regions, restrained iconography, borders, and progress indicators. Navigation and editing share the same component language across six product sections. The browser's print variant deliberately abandons the app chrome for a plain finance report.",
    "keyCharacteristics": [
      "Compact, data-forward finance layout rather than an image-led promotional surface.",
      "Dark-by-default, light-capable paired palettes mapped through existing CSS custom properties.",
      "Fine borders, subtle panel elevation, mint state cues, and warm outgoing/warning colors.",
      "Reusable form, financial card, table, progress, reminder, and modal patterns."
    ],
    "rules": [
      {
        "name": "The Semantic Pairing Rule",
        "body": "Existing semantic CSS variables have paired dark and light values. Extend both themes when a future change adds a semantic UI color; do not assume a dark-only value will remain readable in light mode.",
        "section": "status and chart colors"
      },
      {
        "name": "The Numeric Emphasis Rule",
        "body": "Major balances are the largest/heaviest text in a card; the supporting captions remain smaller and muted.",
        "section": "hierarchy"
      },
      {
        "name": "The Workspace-First Rule",
